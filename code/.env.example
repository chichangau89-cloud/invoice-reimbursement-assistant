# Existing MySQL / Milvus variables may remain in ../PythonProject1/.env.
# Values here override that file; real process environment has highest priority.
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus
LLM_TIMEOUT=45
LLM_MAX_RETRIES=1
# False avoids inherited broken local proxies. Enable only if a proxy is needed.
LLM_TRUST_ENV=false
